{
    "name": "derafu/support",
    "description": "Derafu: Support - Essential PHP Utilities.",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/core/support",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/support/issues",
        "source": "https://github.com/derafu/support"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsSupport\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/translation": "dev-main"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "league/csv": "^9.28",
        "nesbot/carbon": "^3.14",
        "symfony/filesystem": "^8.1",
        "symfony/mime": "^8.1",
        "maennchen/zipstream-php": "^3.2",
        "nikic/php-parser": "^5.9"
    },
    "suggest": {
        "league/csv": "Required by Derafu\\Support\\Csv (read, write, generate and send CSV files).",
        "nesbot/carbon": "Required by Derafu\\Support\\Date (all its date and period helpers).",
        "symfony/filesystem": "Required by Derafu\\Support\\File::rmdir() (recursive removal that does not follow symbolic links).",
        "symfony/mime": "Required by Derafu\\Support\\File::mimetype() (MIME type detection).",
        "maennchen/zipstream-php": "Required by Derafu\\Support\\File::zip() (ZIP archives).",
        "nikic/php-parser": "Required by the tests of the messages of the package (Derafu\\Translation\\Lint reads the code)."
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline",
        "build": "npm run build"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
